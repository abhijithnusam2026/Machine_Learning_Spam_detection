# Railway deployment image for the Gradio app (app.py), including the
# live 3-second-window scam monitor. Separate from the root Dockerfile,
# which runs api_server.py (FastAPI) for a different deployment target.
FROM python:3.11-slim

WORKDIR /app

# ffmpeg: audio resampling. git/cmake/make/g++: build whisper.cpp from source.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    git \
    cmake \
    make \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Python deps before copying the rest of the source so code-only
# changes don't invalidate this (slow) layer.
#
# `spaces` and `hf-gradio` are dropped: they're HF-Spaces-only packages
# (unused by any import in this repo) and requirements.txt currently pins
# hf-gradio==0.4.1, which requires gradio-client>=2.0 -- incompatible with
# the gradio_client==1.3.0 that gradio==4.44.1 needs. Filtering them here
# avoids touching requirements.txt, which the HF Spaces deploy still relies on.
COPY requirements.txt .
RUN pip install --no-cache-dir uv \
    && uv pip install --system torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cpu \
    && grep -v -E '^(spaces|hf-gradio)==' requirements.txt > requirements.railway.txt \
    && uv pip install --system -r requirements.railway.txt

COPY . /app/

# Build whisper.cpp at image build time so the container never has to
# compile it on first request (InferencePipeline falls back to compiling
# at runtime if the binary is missing, but that's slow and needs git+cmake
# present in the final image, which we'd rather avoid keeping around).
RUN rm -rf whisper.cpp \
    && git clone https://github.com/ggerganov/whisper.cpp.git \
    && cd whisper.cpp && make

# Railway injects PORT at runtime; app.py reads it via os.environ.
EXPOSE 7860

CMD ["python", "app.py"]
