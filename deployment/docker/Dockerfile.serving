FROM vllm/vllm-openai:v0.6.6.post1

WORKDIR /app

ENV PYTHONPATH=/app \
    HF_HOME=/models/huggingface \
    TRANSFORMERS_CACHE=/models/huggingface \
    VLLM_BASE_URL=http://127.0.0.1:8001/v1 \
    SERVED_MODEL_NAME=call-center-qwen25

COPY pyproject.toml README.md ./
COPY src ./src
COPY deployment/docker/serve_vllm_and_api.sh /usr/local/bin/serve_vllm_and_api.sh

RUN pip install --no-cache-dir fastapi==0.115.6 httpx==0.28.1 pydantic==2.10.4 uvicorn==0.34.0 \
    && chmod +x /usr/local/bin/serve_vllm_and_api.sh

EXPOSE 8000 8001

CMD ["/usr/local/bin/serve_vllm_and_api.sh"]
