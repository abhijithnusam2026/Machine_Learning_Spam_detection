{
  "title": "Call Center Intelligence API",
  "timezone": "browser",
  "panels": [
    {
      "title": "Request Throughput (ops/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(call_center_api_requests_total[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}}"
        }
      ]
    },
    {
      "title": "Error Rate (5xx/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(call_center_api_errors_total[1m])) by (method, path)",
          "legendFormat": "{{method}} {{path}} Errors"
        }
      ]
    },
    {
      "title": "p95 Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(call_center_api_request_latency_seconds_bucket[5m])) by (le, method, path))",
          "legendFormat": "{{method}} {{path}} p95"
        }
      ]
    }
  ],
  "schemaVersion": 36,
  "refresh": "10s"
}
